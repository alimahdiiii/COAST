FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1e-4;
        value           uniform 1e-4;
    }

    coast
    {
        type            kqRWallFunction;
        value           uniform 1e-4;
    }

    ground
    {
        type            kqRWallFunction;
        value           uniform 1e-4;
    }

    top
    {
        type            inletOutlet;
        inletValue      uniform 1e-4;
        value           uniform 1e-4;
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }
}

