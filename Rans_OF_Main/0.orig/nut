FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    // rough slope / structure
    coast
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.0001;   // <-- choose for your gamma_f
        Cs              uniform 0.5;
        value           uniform 0;
    }

    // rough seabed (if you want)
    ground
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.01;
        Cs              uniform 0.5;
        value           uniform 0;
    }

    top
    {
        type            calculated;
        value           uniform 0;
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }
}

