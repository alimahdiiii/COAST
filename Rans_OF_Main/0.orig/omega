FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1.0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1.0;
        value           uniform 1.0;
    }

    coast
    {
        type            omegaWallFunction;
        value           uniform 1.0;
    }

    ground
    {
        type            omegaWallFunction;
        value           uniform 1.0;
    }

    top
    {
        type            inletOutlet;
        inletValue      uniform 1.0;
        value           uniform 1.0;
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }
}

