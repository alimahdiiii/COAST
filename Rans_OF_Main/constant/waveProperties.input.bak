FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      waveProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

seaLevel            0.0;
seaLevelAsReference true;

relaxationNames     (inlet);

initializationName  inlet;

inletCoeffs
{
    waveType irregular;
    spectrum JONSWAP;
    
    frequencyAxis
    {
        type           angularFrequency;
        discretisation equidistantFrequencyAxis;
    }
    

    Hs              0.1;
    Tp              1.1;
    gamma           3.3;
    N               100;
    Tsoft           2.0;
    depth           0.622;
    direction       (1 0 0);
    phi             0;


    phaseMethod     randomPhase;
    seedForRandom   1234;
    
    
    relaxationZone
    {
        relaxationScheme Spatial;
        relaxationShape  Rectangular;
        beachType        Empty;

        relaxType   INLET;
        startX      (-7.75 0.0 -0.622);
        endX        (-5 1.0  0.578);
        orientation (1.0 0.0 0.0);
    }
}


// ************************************************************************* //

