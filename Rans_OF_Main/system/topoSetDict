FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    // 1) start from the existing boundary patch "coast"
    {
        name    x04;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo
        {
            patch coast;
        }
    }

    // 2) keep only faces inside a selection box around the segment
    {
        name    x04;
        type    faceSet;
        action  subset;
        source  boxToFace;
        sourceInfo
        {
            box (2.48 0.0 0.48) (2.52 1.0 1.02);
        }
    }
);

